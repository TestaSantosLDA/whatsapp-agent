# API
PORT=3000
# Postgres connection string. Leave empty to use an embedded PGlite database (data/pglite).
DATABASE_URL=
# Directory with client YAML files (default: <repo>/clients)
# CLIENTS_DIR=
# Shared secret the simulator uses to post to /webhook/simulator
SIMULATOR_WEBHOOK_SECRET=change-me-please
# Access code the simulator UI asks for. Empty disables the check (local only).
SIMULATOR_ACCESS_CODE=
# Queue: "inprocess" (default) runs jobs in this process. "cloudtasks" hands them to Google Cloud
# Tasks, which POSTs them back to /jobs/run/<job> (Cloud Run, see docs/deploy.md). It needs
# GCP_PROJECT, CLOUD_TASKS_LOCATION, CLOUD_TASKS_QUEUE, JOBS_SECRET and an https PUBLIC_BASE_URL.
QUEUE=inprocess
# GCP_PROJECT=
# CLOUD_TASKS_LOCATION=europe-west1
# CLOUD_TASKS_QUEUE=wa-conversations
# Delay before Cloud Tasks delivers a turn, so a burst of messages is answered at once (ms).
# CLOUD_TASKS_DELAY_MS=1500
# Apply migrations / sync catalogues when the server starts (default true). Cloud Run sets both
# to false: CI migrates before each deploy and Cloud Scheduler syncs every hour.
# MIGRATE_ON_START=true
# SYNC_ON_START=true
# Built simulator served at / (default: <repo>/apps/simulator/dist/simulator/browser, after
# `pnpm build`). Not served when the directory is missing.
# SIMULATOR_DIST_DIR=
# Embedded PGlite data directory when DATABASE_URL is empty (default: <repo>/data/pglite)
# PGLITE_DIR=
# Public base URL of this API, used for links to its own files (e.g. images). Set it on any deploy.
PUBLIC_BASE_URL=http://localhost:3000
# Secret schedulers send as the x-jobs-secret header to /jobs/* (e.g. hourly catalogue sync).
# At least 16 characters. Empty disables the jobs routes (they answer 503).
JOBS_SECRET=
# Real WhatsApp Cloud API (WA-030): app secret for webhook signatures and the verify token.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Claude API key. Empty = a test bot echoes messages instead of the Claude agent.
ANTHROPIC_API_KEY=
# Resend API key for business emails (leads, handoffs, order drafts). Empty = emails stay in the
# outbox table and the back-office panel only. The sender is `mail.from` in the client config.
RESEND_API_KEY=
# Google service account key (the JSON file's contents, on one line) for clients whose
# lead.sinks include sheets. Share the sheet with the account's client_email as an editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
