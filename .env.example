# API
PORT=3000
# Postgres connection string. Leave empty to use an embedded PGlite database (data/pglite).
DATABASE_URL=
# Directory with client YAML files (default: <repo>/clients)
# CLIENTS_DIR=
# Shared secret the simulator uses to post to /webhook/simulator
SIMULATOR_WEBHOOK_SECRET=change-me-please
# Access code the simulator UI asks for. Empty disables the check (local only).
SIMULATOR_ACCESS_CODE=
# Queue: "inprocess" (default). "cloudtasks" arrives with WA-020.
QUEUE=inprocess
