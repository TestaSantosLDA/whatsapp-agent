{
  "name": "whatsapp-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @wa/shared build && pnpm --parallel --filter @wa/shared --filter @wa/api --filter @wa/simulator --filter @wa/admin run dev",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @wa/api run db:migrate",
    "db:generate": "pnpm --filter @wa/api run db:generate",
    "db:seed": "pnpm --filter @wa/api run db:seed",
    "sync:catalogue": "pnpm --filter @wa/api run sync:catalogue",
    "eval": "pnpm --filter @wa/api run eval",
    "eval:compare": "pnpm --filter @wa/api run eval:compare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
